// -*- mode: jsonc -*-
{
  "height": 45,
  "spacing": 6,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "pulseaudio",
    "pulseaudio/slider",
    "network",
    "clock",
    "tray",
    "custom/power"   // uncomment only if power_menu.xml exists
    // "custom/media"   // uncomment only if mediaplayer.py exists
  ],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true
  },

  "hyprland/window": {
    "format": "{}"
  },

  "clock": {
    "format": "{:%H:%M  %b %d}",        // ← %d = day of month
    "format-alt": "{:%A, %B %d, %Y (%R)}  ",
    "tooltip-format": "<tt>{calendar}</tt>",
    "interval": 60,                       // updates every minute (optional but nice)
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",         // note: duplicate keys get overridden; pick one action per direction
      "on-scroll-down": "shift_down"
    }
  },


  "cpu": { "format": "{usage}% ", "tooltip": false },
  "memory": { "format": "{}% " },

  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""]
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol"
  },
  "pulseaudio/slider": {
      "min": 0,
      "max": 100,
      "orientation": "horizontal"
  },
  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{ifname} via {gwaddr} "
  },

  "tray": {
    "spacing": 8
  },
  "custom/power": {
    "format" : "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
    "menu-actions": { 
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  }
}

